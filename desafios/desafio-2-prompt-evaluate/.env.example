# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Handle do Hub no MESMO workspace/tenant da LANGSMITH_API_KEY (ex.: slug da org ou nome do tenant).
# Se o push falhar com "Cannot create a prompt for another tenant", este valor não bate com o tenant da key — corrija para o namespace correto (mensagem mostra "Current tenant").
USERNAME_LANGSMITH_HUB="meu-first-prompt"

# OpenAI Configuration
OPENAI_API_KEY=

# Google Gemini Configuration
GOOGLE_API_KEY=

# LLM Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
EVAL_MODEL=gemini-2.5-flash

# OpenAI (desafio sugere gpt-4o-mini para gerar respostas; se métricas ficarem abaixo de 0.9,
# teste LLM_MODEL=gpt-4o — mesmo EVAL_MODEL=gpt-4o — custo maior, alinhamento ao reference costuma melhorar.)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gpt-4o
# EVAL_MODEL=gpt-4o